{
  "name": "family-bible-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private family Bible study companion: weekly program, role cards, activities, and jw.org-sourced study results.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test scripts/catalogue-pipeline.test.mjs scripts/watchtower-private-pack.test.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "hydrate:watchtower-verses": "node scripts/extract-jw-verses.mjs",
    "build:watchtower-private-pack": "node scripts/watchtower-private-pack.mjs",
    "validate:watchtower": "node scripts/validate-watchtower-studies.mjs",
    "validate:studies": "node scripts/validate-studies.mjs",
    "validate:catalogues": "npm run validate:studies && npm run validate:watchtower"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelolockdev/family-bible-study.git"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
